# ============================================================
# Quiz Battle - Production Environment (THUÊ SERVER)
#
# File này nằm ở thư mục gốc trên server, cạnh docker-compose.yml.
# Dùng cho: docker compose up -d --build
#
# LƯU Ý BẢO MẬT:
#   - File này KHÔNG được commit lên git (đã có trong .gitignore).
#   - Mỗi server / mỗi môi trường (staging, prod) nên có 1 file riêng.
#   - Tất cả secret dưới đây phải được generate MỚI, KHÔNG dùng lại
#     giá trị cũ từ lịch sử git / repo public.
# ============================================================

# ----- App -----
# BẬT false khi deploy thật. Nếu true, stack trace sẽ lộ ra ngoài.
DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=THAY_BANG_KEY_MOI_GENERATE_BANG_PYTHON
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
API_V1_STR=/api/v1
PROJECT_NAME=Quiz Battle
ALLOWED_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# ----- Database -----
POSTGRES_USER=quiz_app
POSTGRES_PASSWORD=THAY_BANG_PASSWORD_MANH_KHONG_DUNG_7906
POSTGRES_DB=quiz
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ----- Redis -----
REDIS_URL=redis://redis:6379/0
ROOM_SESSION_TTL_SECONDS=86400

# ----- Google OAuth -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/callback

# ----- Email OTP SMTP -----
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=True

# ----- Gemini proxy -----
GEMINI_PROXY_BASE_URL=https://api.shopaikey.com/v1
GEMINI_PROXY_API_KEY=
LLM_MODEL=gemini-2.5-flash
INTENT_ROUTER_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072
GEMINI_PROXY_TIMEOUT=30
GEMINI_PROXY_MAX_RETRIES=2

# ----- Qdrant -----
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_VECTOR_SIZE=3072
QDRANT_DISTANCE=Cosine

# ----- Embedding / retrieval tunables -----
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_CHARS=8000
RETRIEVAL_DEFAULT_TOP_K=10
RETRIEVAL_MAX_TOP_K=50
RETRIEVAL_CANDIDATE_MULTIPLIER=3

# ----- Frontend -----
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
NEXT_PUBLIC_WS_URL=wss://yourdomain.com
